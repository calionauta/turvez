{
  "name": "TODO-CLIENT.cron-job",
  "version": "1.0.0",
  "steps": [
    {
      "id": "build-fetch",
      "task": "transform.json",
      "type": "normal",
      "timeout": 30000000000,
      "metadata": {
        "expression": "{method: \"GET\", url: \"https://api.example.com/things?limit=100\", auth_secret: \"TODO_CLIENT_TOKEN\", response_json: true}"
      }
    },
    {
      "id": "fetch",
      "task": "http.request",
      "type": "normal",
      "timeout": 120000000000,
      "depends_on": ["build-fetch"],
      "retry": {
        "max_attempts": 3,
        "strategy": "exponential",
        "initial_delay": 2000000000,
        "max_delay": 30000000000,
        "multiplier": 2.0
      }
    },
    {
      "id": "summarize",
      "task": "transform.json",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["fetch"],
      "metadata": {
        "expression": "{count: (.json.results | length)}"
      }
    }
  ],
  "triggers": [
    {
      "id": "TODO-CLIENT-cron",
      "cron": {
        "expression": "0 2 * * *",
        "timezone": "UTC"
      }
    }
  ]
}
