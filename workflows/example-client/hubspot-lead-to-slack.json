{
  "name": "example-client/hubspot-lead-to-slack",
  "version": "1.0.0",
  "steps": [
    {
      "id": "build-fetch",
      "task": "transform.json",
      "type": "normal",
      "timeout": 30000000000,
      "metadata": {
        "expression": "((.data // .) | {lead_id: .lead_id}) as $r | {method: \"GET\", url: (\"https://api.hubapi.com/crm/v3/objects/contacts/\" + $r.lead_id + \"?properties=firstname,lastname,email\"), auth_secret: \"ACME_HUBSPOT_TOKEN\", auth_scheme: \"Bearer\", response_json: true}"
      }
    },
    {
      "id": "fetch-lead",
      "task": "http.request",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["build-fetch"],
      "retry": {
        "max_attempts": 3,
        "strategy": "exponential",
        "initial_delay": 2000000000,
        "max_delay": 30000000000,
        "multiplier": 2.0
      }
    },
    {
      "id": "build-notify",
      "task": "transform.json",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["fetch-lead"],
      "metadata": {
        "expression": "{webhook_secret: \"ACME_SLACK_WEBHOOK_URL\", message: (\"New lead: \" + (.json.properties.firstname // \"unknown\") + \" \" + (.json.properties.lastname // \"\") + \" <\" + (.json.properties.email // \"no-email\") + \">\")}"
      }
    },
    {
      "id": "notify",
      "task": "notify.slack",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["build-notify"]
    }
  ],
  "triggers": [
    {
      "id": "lead-webhook",
      "webhook": {
        "path": "/hooks/example-client/lead"
      }
    }
  ]
}
