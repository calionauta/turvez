{
  "name": "example-client/invoice-paid-route",
  "version": "1.0.0",
  "steps": [
    {
      "id": "build-fetch",
      "task": "transform.json",
      "type": "normal",
      "timeout": 30000000000,
      "metadata": {
        "expression": "((.data // .) | {invoice_id: .invoice_id}) as $r | {method: \"GET\", url: (\"https://api.example.com/invoices/\" + $r.invoice_id), auth_secret: \"ACME_BILLING_TOKEN\", auth_scheme: \"Bearer\", response_json: true}"
      }
    },
    {
      "id": "fetch-invoice",
      "task": "http.request",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["build-fetch"],
      "retry": {
        "max_attempts": 3,
        "strategy": "exponential",
        "initial_delay": 2000000000,
        "max_delay": 30000000000,
        "multiplier": 2.0
      }
    },
    {
      "id": "shape",
      "task": "transform.json",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["fetch-invoice"],
      "metadata": {
        "expression": "{high_value: (.json.total > 10000), vip: {webhook_secret: \"ACME_SLACK_WEBHOOK_URL\", message: (\"VIP invoice paid: \" + (.json.customer // \"?\") + \" $\" + ((.json.total | tostring) // \"?\"))}, std: {webhook_secret: \"ACME_SLACK_WEBHOOK_URL\", message: (\"Invoice paid: \" + (.json.customer // \"?\") + \" $\" + ((.json.total | tostring) // \"?\"))}}"
      }
    },
    {
      "id": "shape-vip",
      "task": "transform.json",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["shape"],
      "skip_if": {
        "step_id": "shape",
        "field": "high_value",
        "op": "==",
        "value": false
      },
      "metadata": {
        "expression": ".vip"
      }
    },
    {
      "id": "shape-std",
      "task": "transform.json",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["shape"],
      "skip_if": {
        "step_id": "shape",
        "field": "high_value",
        "op": "==",
        "value": true
      },
      "metadata": {
        "expression": ".std"
      }
    },
    {
      "id": "notify-vip",
      "task": "notify.slack",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["shape-vip"]
    },
    {
      "id": "notify-std",
      "task": "notify.slack",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["shape-std"]
    }
  ]
}
