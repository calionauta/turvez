{
  "name": "example-client/nightly-sync",
  "version": "1.0.0",
  "steps": [
    {
      "id": "build-fetch",
      "task": "transform.json",
      "type": "normal",
      "timeout": 30000000000,
      "metadata": {
        "expression": "{method: \"GET\", url: \"https://api.example.com/contacts?limit=100\", auth_secret: \"ACME_HUBSPOT_TOKEN\", auth_scheme: \"Bearer\", response_json: true}"
      }
    },
    {
      "id": "fetch-contacts",
      "task": "http.request",
      "type": "normal",
      "timeout": 120000000000,
      "depends_on": ["build-fetch"],
      "retry": {
        "max_attempts": 3,
        "strategy": "exponential",
        "initial_delay": 2000000000,
        "max_delay": 30000000000,
        "multiplier": 2.0
      }
    },
    {
      "id": "summarize",
      "task": "transform.json",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["fetch-contacts"],
      "metadata": {
        "expression": "{count: (.json.results | length)}"
      }
    },
    {
      "id": "build-push",
      "task": "transform.json",
      "type": "normal",
      "timeout": 30000000000,
      "depends_on": ["summarize"],
      "metadata": {
        "expression": "{method: \"POST\", url: \"https://warehouse.example.com/load\", auth_secret: \"ACME_WAREHOUSE_TOKEN\", auth_scheme: \"Bearer\", response_json: true, body: {contacts_synced: .count}}"
      }
    },
    {
      "id": "push",
      "task": "http.request",
      "type": "normal",
      "timeout": 120000000000,
      "depends_on": ["build-push"],
      "retry": {
        "max_attempts": 3,
        "strategy": "exponential",
        "initial_delay": 2000000000,
        "max_delay": 30000000000,
        "multiplier": 2.0
      }
    }
  ],
  "triggers": [
    {
      "id": "nightly-sync-cron",
      "cron": {
        "expression": "0 2 * * *",
        "timezone": "UTC"
      }
    }
  ]
}
