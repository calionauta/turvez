# Per-client secret NAMES for example-client. Copy to
# env/example-client.env (gitignored) and fill real values, or encrypt:
# age --encrypt -r age1YOURPUBLICKEY -o secrets/example-client/env.age env/example-client.env
#
# These names match the auth_secret / webhook_secret / api_key_secret
# references in workflows/example-client/*.json. Values never go in JSON.
#
# What lives here vs in Nango (docs/nango.md):
#   Nango        provider OAuth + provider API keys — HubSpot, Google, Slack
#                (bot) tokens. Nango refreshes them; we never see the value.
#                Connection-Id is always the client slug.
#   this file    our own plumbing: incoming webhook URLs, signing secrets,
#                DB/SMTP/SSH credentials, the client's internal API tokens.

# Nango itself (names only; the values are in the operator vault / age file)
NANGO_HOST=http://localhost:8088
NANGO_SECRET_KEY=

# Slack incoming webhook: a static URL we own, not a revocable OAuth grant,
# so it stays here instead of a Nango connection.
ACME_SLACK_WEBHOOK_URL=

# Billing / refunds / warehouse / internal contacts API: the client's own
# APIs, addressed with a bearer token. Put them in Nango as API-key connections
# when the client can rotate them without telling us; keep them here when they
# are infra credentials.
ACME_INTERNAL_API_TOKEN=
ACME_REFUND_API_TOKEN=
ACME_BILLING_TOKEN=
ACME_WAREHOUSE_TOKEN=
