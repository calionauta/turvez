# Per-client secret NAMES for personal automations. Copy to
# env/personal.env (gitignored) and fill real values, or encrypt:
# age --encrypt -r age1YOURPUBLICKEY -o secrets/personal/env.age env/personal.env
#
# These names match the secret references in workflows/personal/*.json.
# Values never go in JSON.

# Personal messaging
PERSONAL_TELEGRAM_BOT_TOKEN=
PERSONAL_TELEGRAM_CHAT_ID=
PERSONAL_SLACK_WEBHOOK_URL=

# LLM for llm.complete (or reuse shared LLM_API_KEY)
LLM_API_KEY=
