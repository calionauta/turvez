# Binaries and build output
/bin/
/dist/
*.test

# Local env with real secrets — never commit (.env.example stays tracked)
.env
# Per-client real env — never commit (templates are env/*.env.example)
env/*.env
# Secret NAMES are documentation, not secrets: re-include the examples. Needed
# because a common global ignore (`*.env.*` in core.excludesFile) would swallow
# them, silently dropping the only file that says which secrets exist.
!env/*.env.example

# Age identities (private keys) — never commit
*.age.key
*identity*.txt

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Python bytecode (the eval scripts are run directly, never installed)
__pycache__/
*.pyc

# Local sandbox outputs (scripts/sandbox-run.sh) — never commit
sandbox-out/

# Local agent memory (Engram) — machine-specific, never commit
.engram/
